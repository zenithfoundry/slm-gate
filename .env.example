# ==============================================================================
#  slm-gate settings
# ==============================================================================
#
# `slm-gate init` copies this file to your settings file and fills in the lines for your computer:
#   npm install   -> ~/.slm-gate/.env
#   git checkout  -> .env in the checkout
# Both gates read ONLY that file (plus the environment they were started with). They never read a
# project's .env, and the shared model gate never takes settings from a coding tool's MCP "env" block.
#
# Every line below is the built-in default. A blank value means "use the default", so you can leave
# a line blank rather than guess. Settings are read once at start: run `slm-gate restart` after a change.
#
# Two parts, both on by default:
#   model gate  an HTTP server your coding tool sends its AI requests to. Shrinks large tool output
#               with the local models before the request goes on to the tool's own provider, with the
#               tool's own login. Nothing is billed differently; less is sent.
#   MCP gate    sits in front of a toolbox (an MCP server) and shrinks what its tools return.
# The savings land in a local ledger (SQLite); `slm-gate metrics` and the dashboard read it.
#
# Docs: https://github.com/zenithfoundry/slm-gate/blob/main/docs/README.md
#   every setting in detail ........ docs/reference/settings.md
#   RAM, models, Ollama memory ..... docs/reference/hardware.md
#   profiles (starter/proven/toolbox) docs/npm/profiles.md

# ==============================================================================
#  SETTINGS YOU MAY WANT
#  The only lines a person decides. `slm-gate init` fills the first four from your RAM.
# ==============================================================================

# Your RAM size: picks the two local models and NUM_CTX below when they are blank.
#   ram-16 | ram-24 | ram-32 | ram-48 | ram-64 | ram-128 | custom (more than 128 GB: start from the 128 GB
#   models and choose bigger ones yourself). The models per preset: docs/reference/hardware.md
RAM_PRESET=custom

# The two local models (any Ollama tag). Blank = the pair for RAM_PRESET.
#   brain: the larger one, for conversation memory, fidelity checks and open questions.
#   gate:  the small, fast one that shrinks tool output.
# Not sure what fits your computer? https://github.com/AlexsJones/llmfit
SLM_BRAIN_MODEL=
SLM_GATE_MODEL=

# How much text a local model holds at once (tokens). 16 GB -> 4096, 24 GB and more -> 8192.
# More context needs more RAM and answers slower; both models' caches must fit next to your apps.
NUM_CTX=8192

# The AI provider your coding tool is logged in with: claude | chatgpt | gemini. Used to attribute a
# request when it names no recognisable model, so the savings figures land under the right provider.
# This is NOT SLM_PROVIDER (where the local models run). Blank = requests without a model name are not
# attributed.
PROVIDER=

# Your subscription plan, for the "usage window freed" figures: claude-pro | claude-max-5x | claude-max-20x |
# chatgpt-go | chatgpt-plus | chatgpt-pro-5x | chatgpt-pro-20x | gemini-plus | gemini-pro | gemini-ultra.
# It sets the window length and, where one is known, an ESTIMATE of the window's budget. Blank = no plan:
# the cycle cards stay empty rather than guess. More than one provider? Use PLAN_* below.
SUBSCRIPTION_PLAN=

# A toolbox (MCP server) for the MCP gate to sit in front of. Blank = standalone: the gate offers only its own
# tools (condition_prompt, expand_elision, ask_elision, find_existing). One line of JSON:
#   tech-lead-stack from npm:        {"command":"npx","args":["-y","tech-lead-stack@1"]}
#   a server you built yourself:     {"command":"node","args":["/full/path/to/dist/mcp-server.mjs"],"env":{}}
#   a server over HTTP:              {"url":"https://host/mcp","headers":{"Authorization":"Bearer TOKEN"}}
# Paths inside the JSON must be full paths: the coding tool starts the gate from a folder of its choosing.
DOWNSTREAM_MCP=

# tech-lead-stack adapter: keeps its skill gates intact and feeds its cost report. on ONLY when DOWNSTREAM_MCP
# is a tech-lead-stack server; `slm-gate doctor` reports on + blank DOWNSTREAM_MCP as an error.
TLS_ADAPTER=off

# Langfuse dashboards (optional). Fill all three to mirror the ledger there, or leave blank for local only.
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_HOST=


# ==============================================================================
#  ADVANCED: SAFE DEFAULTS
#  Everything below equals the built-in default. Change a line only when a docs page says to.
# ==============================================================================

# ── The local models ──────────────────────────────────────────────────────────

# Where the local models run: ollama (normal) | openai (another OpenAI-style server at OLLAMA_HOST).
SLM_PROVIDER=ollama
OLLAMA_HOST=http://localhost:11434

# How long Ollama keeps a model loaded after its last call (5m, 1h, 12h, or -1 for always).
OLLAMA_KEEP_ALIVE=12h

# Keep both local models loaded. When something else loads a third model and evicts one of the pair,
# the model gate unloads the stranger and warms its own model back in (checked every minute).
# Needs OLLAMA_MAX_LOADED_MODELS=2 where Ollama reads it: docs/reference/hardware.md
SLM_PIN_MODELS=on

# Randomness of the local models. 0 = the same input gives the same result (and cache hits).
TEMPERATURE=0

# The most time one local-model call may take (ms). Past it the step fails open: the text goes through
# as it was. 30000 suits a fast GPU with small models; 120000 suits 7B-14B models or CPU inference.
SLM_TIMEOUT_MS=120000

# When the resolver answers an open question from common practice, it asks the brain model this many
# times and keeps the answer only when the runs agree (1 = ask once). SELF_CONSISTENCY_TEMP is the
# randomness of those re-asks; it must be above 0 or every re-ask is identical.
SELF_CONSISTENCY_K=3
SELF_CONSISTENCY_TEMP=0.7

# ── The model gate ────────────────────────────────────────────────────────────

# The port your coding tools send their AI requests to (http://localhost:8787). Set it only here: the
# value in a tool's MCP env block is ignored when finding the gate, so every tool uses the same one.
LLM_GATE_PORT=8787

# Start the model gate by itself whenever a coding tool starts slm-gate's MCP server, and bring it back
# within a minute if it stops. off = you run `slm-gate start` yourself.
LLM_GATE_AUTOSTART=on

# Shrink large command, search and listing results before a request leaves your machine. Each result is
# shrunk once and the same shorter text is resent every later turn, so the provider's prompt cache keeps
# working. off = send every request unchanged.
LLM_GATE_DISTILL=on

# Where each kind of request goes on to. Blank = the provider's own address (the right one is chosen from
# the request). Set one only when your company routes all AI traffic through its own gateway.
UPSTREAM_ANTHROPIC_URL=
UPSTREAM_OPENAI_URL=
UPSTREAM_CHATGPT_URL=
UPSTREAM_GEMINI_URL=

# ── Conversation memory ───────────────────────────────────────────────────────

# The model gate keeps a short running summary of each conversation (the goal, what was decided, the
# names that keep coming up), folded by the brain model between requests, never on the request path.
# The local steps read it beside the message they answer. It lives only in the ledger: never in event
# rows, Langfuse or logs. `slm-gate memory` shows it. off = every local step sees one message at a time.
CONVERSATION_MEMORY=on

# The summary's size (tokens) and the most new text one fold reads (tokens). Blank = 400 and 3000 at
# NUM_CTX 8192, 300 and 2000 at 4096: previous summary + new text + answer must fit NUM_CTX.
MEMORY_MAX_TOKENS=
MEMORY_FOLD_INPUT_TOKENS=

# The least time between two folds of one conversation (ms), and how old a summary may be (ms) before
# every reader ignores it (600000 = ten minutes).
MEMORY_FOLD_INTERVAL_MS=20000
MEMORY_MATCH_WINDOW_MS=600000

# ── The MCP gate ──────────────────────────────────────────────────────────────

# How your coding tool connects to the MCP gate: stdio (normal) | http (then on MCP_GATE_PORT).
MCP_GATE_TRANSPORT=stdio
MCP_GATE_PORT=8788

# Repository symbol index: the find_existing tool, index-backed resolver evidence and an "Existing code that
# may already cover this" section on conditioned skills. A small FTS5 table in the ledger, refreshed by file
# mtime; no model, no embeddings.
REPO_INDEX=off

# ── Shrinking tool output ─────────────────────────────────────────────────────

# Rough guide: 4 characters is a token; 1,000 tokens is about 750 words or 100 lines of code.

# A result smaller than DISTILL_MIN_TOKENS is left alone. A result larger than DISTILL_MAX_TOKENS after
# shrinking is cut there, with a marker the agent can expand on demand (expand_elision). DISTILL_MAX_TOKENS
# is also the size at which the local model is asked to shrink at all.
DISTILL_MAX_TOKENS=2000
DISTILL_MIN_TOKENS=500

# How long (ms) the model gate may hold one request to shrink its new tool results. Past it, a result is
# sent as it was, and stays that way for the rest of the conversation (prompt cache). Never blocks.
DISTILL_BUDGET_MS=3000

# Prose runs the gate model shortens at the same time (1 or 2). One GPU serves both local models, so 2 is
# not twice as fast as 1; `pnpm run bench:gate` measures both on this machine.
MAX_CONCURRENT_SEGMENT_CALLS=2

# Also shorten the prose of skill and instruction files, under the fidelity guard below. Lines with rules,
# tool names, paths, numbers, headings, fences, tables and frontmatter are protected by code and never
# shown to a model. off = skills go through untouched.
DISTILL_SKILLS=off

# The fidelity guard (DISTILL_SKILLS=on): each shortened prose run is checked by the brain model against the
# requirement sentences listed from the original and kept only when recall >= DISTILL_FIDELITY_MIN
# (1.0 = nothing missing). At most DISTILL_FIDELITY_MAX_RUNS runs per document, inside
# DISTILL_FIDELITY_BUDGET_MS (ms); the rest stay verbatim.
DISTILL_FIDELITY_MIN=1.0
DISTILL_FIDELITY_MAX_RUNS=8
DISTILL_FIDELITY_BUDGET_MS=60000

# Extra text patterns the shrinker must never touch, as a JSON file: {"mode":"extend","patterns":["^## Acceptance
# Criteria","\\bDEADLINE\\b"]}. The built-ins already protect MUST/SHALL lines, URLs, tables, code and headings.
# A relative path is read from slm-gate's install folder (configs/preserve/tls.json ships for tech-lead-stack).
# DISTILL_PRESERVE_MODE: extend = added to the built-ins | replace = only your patterns.
DISTILL_PRESERVE_PATH=
DISTILL_PRESERVE_MODE=extend

# Learn from expansions: when the agent asks for lines that were shrunk away, remember their meaning and
# protect lines that mean the same next time. Needs a third local model (EMBED_MODEL) and more RAM.
# DISTILL_ADAPTIVE_THRESHOLD: how similar a line must be (0.86 = very similar). EXPLORE_RATE: the share
# of unprotected lines checked against memory, to bound the cost.
DISTILL_ADAPTIVE=off
DISTILL_ADAPTIVE_THRESHOLD=0.86
DISTILL_ADAPTIVE_EXPLORE_RATE=0.15

# The elision cache: every shrunk result's original, kept in the ledger so the agent can get the trimmed
# lines back without re-running the tool. Rows older than ELISION_RETENTION_DAYS go; past ELISION_MAX_MB
# the least recently used go first.
ELISION_RETENTION_DAYS=180
ELISION_MAX_MB=500

# Part of every cache key (prompt conditioning and tool-output shrinking). Move it up (v12 -> v13) after
# changing a prompt or swapping a local model, or when release notes say to; every cached result is then redone.
PROMPT_VERSION=v12

# ── The resolver's API model (optional, metered) ──────────────────────────────

# The MCP gate may send an unclear request to a paid API model as a last resort. This costs per-token
# dollars on top of your subscription; every call is logged in the ledger. Needs the CLOUD_* lines.
# RESOLVER_CLOUD_BUDGET_USD caps the lifetime spend (0 = never spend).
RESOLVER_CLOUD_TIER=off
RESOLVER_CLOUD_BUDGET_USD=0

# The most skill text (tokens) the resolver puts in one local-model prompt; longer skills are trimmed by
# section. Blank = 3000 at NUM_CTX 8192, 2000 at 4096 (the whole prompt must fit NUM_CTX).
RESOLVER_PROMPT_TOKENS=

# The API model: read only by the resolver's cloud tier and SLM_PROVIDER=openai. The model gate never uses
# it (it forwards each tool's own login). CLOUD_API_STYLE: openai | anthropic (Gemini uses openai, at
# https://generativelanguage.googleapis.com/v1beta/openai/).
CLOUD_API_STYLE=openai
CLOUD_BASE_URL=
CLOUD_API_KEY=
CLOUD_MODEL=

# Reuse the resolver's conditioning results for requests that mean the same thing, measured by cosine
# similarity of their embeddings (SEMCACHE_THRESHOLD, 0.95 = near-identical). Needs EMBED_MODEL pulled.
SEMCACHE=off
SEMCACHE_THRESHOLD=0.95
EMBED_MODEL=nomic-embed-text

# ── Savings figures ───────────────────────────────────────────────────────────

# One plan per provider when you use more than one (each wins over SUBSCRIPTION_PLAN for its provider).
PLAN_CLAUDE=
PLAN_CHATGPT=
PLAN_GEMINI=

# A measured budget for your usage window, which wins over the plan's estimate: tokens per window for
# Claude and Gemini, messages per window for ChatGPT. Claude Code shows the share of the window used
# with /usage; budget = tokens sent in a window / share used. Providers publish no figures, so the
# plan estimates (and the minutes shown) are within a margin of error.
CLAUDE_WINDOW_BUDGET=
CHATGPT_WINDOW_BUDGET=
GEMINI_WINDOW_BUDGET=

# A JSON file that overrides the built-in provider registry (window lengths, model-name patterns).
PROVIDER_REGISTRY_PATH=

# ── The ledger and Langfuse ───────────────────────────────────────────────────

# Where the ledger lives. Blank = output/ledger.sqlite in the settings folder, as a full path. A value must
# be a full path too: the coding tool starts the gate from a folder of its choosing, and a relative path
# fails there with ENOENT while looking fine in a terminal.
LEDGER_PATH=

# Langfuse environment the gate's traces land in (lowercase letters, digits, - and _; not starting with
# 'langfuse'; not 'default', where other writers to the project land). Keeps the gate's traffic its own.
LANGFUSE_ENVIRONMENT=slm-gate

# How many days of data your Langfuse plan keeps (Hobby: 30). Only the dashboard text reads it.
LANGFUSE_RETENTION_DAYS=30
