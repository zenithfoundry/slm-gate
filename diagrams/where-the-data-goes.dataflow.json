  "cards": [
    {
      "dot": "emerald",
      "title": "What a row holds",
      "items": [
        "Token counts before and after, the route taken, timings, which tool, how many tool schemas",
        "Never the text of a prompt, a result or a reply",
        "Rows for your coding tool's traffic carry no price; only the optional cloud step of open decisions does"
      ]
    },
    {
      "dot": "amber",
      "title": "Minutes freed are an estimate",
      "items": [
        "Each plan's window length and budget live in src/pricing; the budget is a measured or published figure",
        "No budget for a provider means no minutes figure, never a made-up one",
        "The Langfuse copy carries the same cost and minutes, worked out when the row is written"
      ]
    },
    {
      "dot": "slate",
      "title": "Langfuse and the published copy",
      "items": [
        "New rows reach Langfuse within 15 s; `slm-gate ledger:sync` sends the history by hand",
        "scripts/dashboard-publish.sh pushes one commit a day that changes only site/data.json",
        "Counts, sums, minutes and dates only; nothing about prompts, tools or skills"
      ]
    }
