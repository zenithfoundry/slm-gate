  "cards": [
    {
      "dot": "emerald",
      "title": "What it never does",
      "items": [
        "Never starts Ollama and never downloads a model: it only says what is missing",
        "With LLM_GATE_AUTOSTART=off it never starts the model gate and checks once only"
      ]
    },
    {
      "dot": "amber",
      "title": "Several MCP gates at once",
      "items": [
        "One per editor window or CLI session; they agree through marker files in output/",
        "One launch per minute, one notification per problem per ten minutes",
        "slm-gate stop holds until start, restart or a reboot"
      ]
    },
    {
      "dot": "slate",
      "title": "The model gate's settings",
      "items": [
        "Launched with every setting removed from its environment, so it reads only the settings file",
        "A running older build is reported, not replaced; run slm-gate restart"
      ]
    }
  ]
