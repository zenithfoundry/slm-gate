  "cards": [
    {
      "dot": "emerald",
      "title": "What it never does",
      "items": [
        "Never answers a request itself: every request reaches your provider, only smaller",
        "Never adds or swaps credentials: the tool's own headers go out as sent",
        "Never changes code blocks, tables, paths, file reads or anything you typed"
      ]
    },
    {
      "dot": "amber",
      "title": "When a local model is slow or down",
      "items": [
        "The text it was working on goes on as it was",
        "The model gate waits at most DISTILL_BUDGET_MS (3 s) per request",
        "Memory folds run only while no request is in flight"
      ]
    },
    {
      "dot": "slate",
      "title": "Only this computer",
      "items": [
        "Both gates listen on 127.0.0.1 and ::1 only and refuse requests from web pages",
        "The conversation memory never leaves the machine"
      ]
    }
  ]
