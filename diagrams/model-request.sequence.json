  "cards": [
    {
      "dot": "emerald",
      "title": "What the ledger row says",
      "items": [
        "forward_compressed: sent with some tool output shrunk; api_in_tok is roughly how many tokens went out",
        "forward_raw: sent unchanged; nothing was large enough, or Ollama was not running",
        "memory_fold: the brain model folded a turn; nothing was sent to your provider"
      ]
    },
    {
      "dot": "amber",
      "title": "What is never changed",
      "items": [
        "File reads (cat and the like too), web fetches and MCP tool results; only results of at least DISTILL_MIN_TOKENS are shrunk",
        "The system prompt, the tool list, anything you typed, ids, thinking, signatures, images and cache_control",
        "The reply streams back byte for byte; past DISTILL_BUDGET_MS (3 s) the original goes"
      ]
    },
    {
      "dot": "slate",
      "title": "Only this computer",
      "items": [
        "Listens on 127.0.0.1 and ::1, accepts only localhost host names, refuses requests from web pages",
        "Refused requests get 403 and are neither forwarded nor recorded; a failed fold keeps the previous summary"
      ]
    }
  ]
